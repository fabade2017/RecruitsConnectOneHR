generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id                   String                     @id @default(uuid())
  name                 String
  acronym              String                     @unique
  industryTemplate     String                     @default("generic") @map("industry_template")
  country              String                     @default("NG") @db.VarChar(2)
  timezone             String                     @default("Africa/Lagos")
  config               String                     @default("{}")
  logoUrl              String?                    @map("logo_url")
  watermarkEnabled     Boolean                    @default(false) @map("watermark_enabled")
  watermarkText        String?                    @map("watermark_text") @db.VarChar(200)
  watermarkOpacity     Float                      @default(0.08) @map("watermark_opacity")
  watermarkPosition    String                     @default("center") @map("watermark_position")
  primaryColor         String?                    @map("primary_color") @db.VarChar(20)
  createdAt            DateTime                   @default(now()) @map("created_at")
  updatedAt            DateTime                   @updatedAt @map("updated_at")
  companyGroupId       String?                    @map("company_group_id")
  assets               Asset[]
  attendanceEvents     AttendanceEvent[]
  attendanceExceptions AttendanceException[]
  attendancePolicy     AttendancePolicy?
  attendanceRecords    AttendanceRecords[]
  auditLogs            AuditLog[]
  bankDetails          BankDetail[]
  branches             Branch[]
  certifications       Certification[]
  compliancePolicies   CompliancePolicy[]
  courses              Course[]
  departments          Department[]
  devices              Device[]
  documents            Document[]
  employees            Employee[]
  engagementSurveys    EngagementSurvey[]
  vacancies            InternalVacancy[]
  jobPostings          JobPosting[]
  knowledgeArticles    KnowledgeArticle[]
  leaveRequests        LeaveRequest[]
  leaveTypes           LeaveType[]
  notifications        Notification[]
  subscriptions        OrganizationSubscription[]
  companyGroup         CompanyGroup?              @relation(fields: [companyGroupId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payrollsMerged       PayrollMerged[]
  performanceReviews   PerformanceReview[]
  policies             Policy[]
  projects             Project[]
  customRoles          RoleDefinition[]
  shifts               Shift[]
  talentOpportunities  TalentOpportunity[]
  tasks                Task[]
  users                User[]
  workSessions         WorkSession[]
  workflowInstances    WorkflowInstance[]
  workflows            Workflow[]
  workforceScores      WorkforceScore[]
  permissions          Permission[]               @relation("OrgPermissions")

  @@map("organizations")
}

model Branch {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  name           String
  address        String?
  location       String?
  isHeadOffice   Boolean      @default(false) @map("is_head_office")
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  departments    Department[]
  employees      Employee[]

  @@index([organizationId])
  @@map("branches")
}

model Department {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  branchId       String?      @map("branch_id")
  parentId       String?      @map("parent_id")
  name           String
  costCenter     String?      @map("cost_center")
  createdAt      DateTime     @default(now()) @map("created_at")
  branch         Branch?      @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parent         Department?  @relation("DeptHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children       Department[] @relation("DeptHierarchy")
  employees      Employee[]

  @@index([organizationId])
  @@map("departments")
}

model User {
  id             String          @id @default(uuid())
  organizationId String          @map("organization_id")
  email          String
  phone          String?
  passwordHash   String          @map("password_hash")
  role           String          @default("employee")
  customRoleId   String?         @map("custom_role_id")
  mfaEnabled     Boolean         @default(false) @map("mfa_enabled")
  lastLoginAt    DateTime?       @map("last_login_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  employee       Employee?
  customRole     RoleDefinition? @relation(fields: [customRoleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([organizationId, email])
  @@map("users")
}

model Employee {
  id                  String                @id @default(uuid())
  organizationId      String                @map("organization_id")
  employeeCode        String                @map("employee_code")
  qrCode              String?               @map("qr_code")
  userId              String?               @unique @map("user_id")
  photoUrl            String?               @map("photo_url")
  faceProfileRef      String?               @map("face_profile_ref")
  departmentId        String?               @map("department_id")
  branchId            String?               @map("branch_id")
  jobTitle            String?               @map("job_title")
  grade               String?
  managerId           String?               @map("manager_id")
  employmentType      String                @default("permanent") @map("employment_type")
  workArrangement     String                @default("office") @map("work_arrangement")
  status              String                @default("active")
  hireDate            DateTime?             @map("hire_date") @db.Date
  probationEndDate    DateTime?             @map("probation_end_date") @db.Date
  skills              String                @default("[]")
  metadata            String                @default("{}")
  consentFace         Boolean               @default(false) @map("consent_face")
  consentGps          Boolean               @default(false) @map("consent_gps")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")
  deletedAt           DateTime?             @map("deleted_at")
  activityRollups     ActivityRollup[]
  assets              Asset[]
  attendanceEvents    AttendanceEvent[]
  exceptionAssignee   AttendanceException[] @relation("ExceptionAssignee")
  exceptionEmployee   AttendanceException[] @relation("ExceptionEmployee")
  attendanceRecords   AttendanceRecords[]
  bankDetail          BankDetail?
  certifications      Certification[]
  devices             Device[]
  documents           Document[]
  branch              Branch?               @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  department          Department?           @relation(fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  manager             Employee?             @relation("Manager", fields: [managerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subordinates        Employee[]            @relation("Manager")
  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user                User?                 @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  engagementResponses EngagementResponse[]
  learningEnrollments LearningEnrollment[]
  leaveApprovals      LeaveRequest[]        @relation("Approver")
  leaveRequests       LeaveRequest[]        @relation("Requester")
  payrollsMerged      PayrollMerged[]
  performanceReviews  PerformanceReview[]
  tasksAssigned       Task[]                @relation("Assignee")
  workSessions        WorkSession[]

  @@unique([organizationId, employeeCode])
  @@index([organizationId, status])
  @@index([managerId])
  @@map("employees")
}

model AttendancePolicy {
  id                         String       @id @default(uuid())
  organizationId             String       @unique @map("organization_id")
  verificationMethods        String       @default("[\"standard\"]") @map("verification_methods")
  requireFaceSnapshot        Boolean      @default(false) @map("require_face_snapshot")
  snapshotCaptureEvents      String       @default("[\"clock_in\"]") @map("snapshot_capture_events")
  snapshotRetentionDays      Int          @default(90) @map("snapshot_retention_days")
  snapshotAccessRoles        String       @default("[\"org_admin\",\"hr_admin\"]") @map("snapshot_access_roles")
  requireGps                 Boolean      @default(false) @map("require_gps")
  gracePeriodMinutes         Int          @default(10) @map("grace_period_minutes")
  overtimeRequiresApproval   Boolean      @default(true) @map("overtime_requires_approval")
  deviceRegistrationRequired Boolean      @default(false) @map("device_registration_required")
  createdAt                  DateTime     @default(now()) @map("created_at")
  updatedAt                  DateTime     @updatedAt @map("updated_at")
  organization               Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("attendance_policies")
}

model Device {
  id                String            @id @default(uuid())
  organizationId    String            @map("organization_id")
  employeeId        String?           @map("employee_id")
  deviceFingerprint String            @map("device_fingerprint")
  deviceType        String            @map("device_type")
  deviceName        String?           @map("device_name")
  isAuthorized      Boolean           @default(true) @map("is_authorized")
  lastSeenAt        DateTime?         @map("last_seen_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  attendanceEvents  AttendanceEvent[]
  employee          Employee?         @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organizationId, deviceFingerprint])
  @@map("devices")
}

model Shift {
  id                   String             @id @default(uuid())
  organizationId       String             @map("organization_id")
  name                 String
  type                 String             @default("fixed")
  startTime            String?            @map("start_time")
  endTime              String?            @map("end_time")
  timezone             String             @default("Africa/Lagos")
  breakDurationMinutes Int                @default(60) @map("break_duration_minutes")
  flexibleWindowStart  String?            @map("flexible_window_start")
  flexibleWindowEnd    String?            @map("flexible_window_end")
  isOvernight          Boolean            @default(false) @map("is_overnight")
  createdAt            DateTime           @default(now()) @map("created_at")
  rosterAssignments    RosterAssignment[]
  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workSessions         WorkSession[]

  @@index([organizationId])
  @@map("shifts")
}

model RosterAssignment {
  id               String   @id @default(uuid())
  employeeId       String   @map("employee_id")
  shiftId          String   @map("shift_id")
  date             DateTime @db.Date
  scheduledMinutes Int      @default(480) @map("scheduled_minutes")
  createdAt        DateTime @default(now()) @map("created_at")
  shift            Shift    @relation(fields: [shiftId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([employeeId, date])
  @@map("roster_assignments")
}

model WorkSession {
  id                    String                @id @default(uuid())
  organizationId        String                @map("organization_id")
  employeeId            String                @map("employee_id")
  shiftId               String?               @map("shift_id")
  date                  DateTime              @db.Date
  clockInAt             DateTime?             @map("clock_in_at")
  clockOutAt            DateTime?             @map("clock_out_at")
  breaks                String                @default("[]")
  grossDurationMinutes  Int?                  @map("gross_duration_minutes")
  breakDurationMinutes  Int?                  @map("break_duration_minutes")
  netWorkingMinutes     Int?                  @map("net_working_minutes")
  scheduledMinutes      Int?                  @map("scheduled_minutes")
  overtimeMinutes       Int?                  @map("overtime_minutes")
  lateMinutes           Int?                  @map("late_minutes")
  earlyDepartureMinutes Int?                  @map("early_departure_minutes")
  status                String                @default("working")
  verificationScore     Int?                  @map("verification_score")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")
  attendanceEvents      AttendanceEvent[]
  exceptions            AttendanceException[]
  employee              Employee              @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organization          Organization          @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  shift                 Shift?                @relation(fields: [shiftId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([organizationId, employeeId, date])
  @@index([organizationId, date])
  @@map("work_sessions")
}

model AttendanceEvent {
  id                 String                @id @default(uuid())
  organizationId     String                @map("organization_id")
  employeeId         String                @map("employee_id")
  workSessionId      String?               @map("work_session_id")
  eventType          String                @map("event_type")
  timestamp          DateTime              @default(now())
  verificationMethod String                @default("standard") @map("verification_method")
  deviceId           String?               @map("device_id")
  location           String?
  faceSnapshotRef    String?               @map("face_snapshot_ref")
  faceConfidence     Decimal?              @map("face_confidence") @db.Decimal(5, 2)
  verificationStatus String                @default("pending") @map("verification_status")
  ipAddress          String?               @map("ip_address")
  metadata           String                @default("{}")
  createdAt          DateTime              @default(now()) @map("created_at")
  device             Device?               @relation(fields: [deviceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employee           Employee              @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workSession        WorkSession?          @relation(fields: [workSessionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  exceptions         AttendanceException[]

  @@index([organizationId, employeeId, timestamp])
  @@index([timestamp])
  @@map("attendance_events")
}

model AttendanceException {
  id                String           @id @default(uuid())
  organizationId    String           @map("organization_id")
  attendanceEventId String?          @map("attendance_event_id")
  workSessionId     String?          @map("work_session_id")
  employeeId        String           @map("employee_id")
  type              String
  severity          String           @default("medium")
  status            String           @default("pending")
  assignedTo        String?          @map("assigned_to")
  details           String           @default("{}")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  assignee          Employee?        @relation("ExceptionAssignee", fields: [assignedTo], references: [id], onDelete: NoAction, onUpdate: NoAction)
  attendanceEvent   AttendanceEvent? @relation(fields: [attendanceEventId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employee          Employee         @relation("ExceptionEmployee", fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workSession       WorkSession?     @relation(fields: [workSessionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organizationId, status])
  @@map("attendance_exceptions")
}

model ActivityRollup {
  id                  String   @id @default(uuid())
  employeeId          String   @map("employee_id")
  date                DateTime @db.Date
  loginSessions       Int      @default(0) @map("login_sessions")
  activeSystemMinutes Int      @default(0) @map("active_system_minutes")
  workflowActions     Int      @default(0) @map("workflow_actions")
  tasksCompleted      Int      @default(0) @map("tasks_completed")
  documentsProcessed  Int      @default(0) @map("documents_processed")
  approvals           Int      @default(0)
  trainingActivities  Int      @default(0) @map("training_activities")
  hrRequests          Int      @default(0) @map("hr_requests")
  computedAt          DateTime @default(now()) @map("computed_at")
  employee            Employee @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([employeeId, date])
  @@map("activity_rollups")
}

model LeaveType {
  id               String         @id @default(uuid())
  organizationId   String         @map("organization_id")
  name             String
  accrualRule      String         @default("{}") @map("accrual_rule")
  maxDays          Int?           @map("max_days")
  requiresApproval Boolean        @default(true) @map("requires_approval")
  createdAt        DateTime       @default(now()) @map("created_at")
  leaveRequests    LeaveRequest[]
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organizationId])
  @@map("leave_types")
}

model LeaveRequest {
  id                 String       @id @default(uuid())
  organizationId     String       @map("organization_id")
  employeeId         String       @map("employee_id")
  leaveTypeId        String       @map("leave_type_id")
  startDate          DateTime     @map("start_date") @db.Date
  endDate            DateTime     @map("end_date") @db.Date
  days               Decimal      @db.Decimal(5, 1)
  reason             String?
  status             String       @default("pending")
  approverId         String?      @map("approver_id")
  workflowInstanceId String?      @map("workflow_instance_id")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  approver           Employee?    @relation("Approver", fields: [approverId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employee           Employee     @relation("Requester", fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  leaveType          LeaveType    @relation(fields: [leaveTypeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organizationId, status])
  @@map("leave_requests")
}

model Project {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  name           String
  description    String?
  ownerId        String?      @map("owner_id")
  status         String       @default("active")
  startDate      DateTime?    @map("start_date") @db.Date
  endDate        DateTime?    @map("end_date") @db.Date
  metadata       String       @default("{}")
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tasks          Task[]

  @@index([organizationId])
  @@map("projects")
}

model Task {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  projectId      String?      @map("project_id")
  assigneeId     String?      @map("assignee_id")
  title          String
  description    String?
  status         String       @default("todo")
  priority       String       @default("medium")
  dueDate        DateTime?    @map("due_date") @db.Date
  completedAt    DateTime?    @map("completed_at")
  estimatedHours Decimal?     @map("estimated_hours") @db.Decimal(5, 2)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  assignee       Employee?    @relation("Assignee", fields: [assigneeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([assigneeId, status])
  @@map("tasks")
}

model PerformanceReview {
  id                String       @id @default(uuid())
  organizationId    String       @map("organization_id")
  employeeId        String       @map("employee_id")
  cycle             String       @default("quarterly")
  kpi               String       @default("[]")
  managerAssessment String?      @map("manager_assessment")
  overallIndicator  String?      @map("overall_indicator")
  reviewDate        DateTime?    @map("review_date") @db.Date
  createdAt         DateTime     @default(now()) @map("created_at")
  employee          Employee     @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([employeeId])
  @@map("performance_reviews")
}

model Document {
  id                 String       @id @default(uuid())
  organizationId     String       @map("organization_id")
  employeeId         String?      @map("employee_id")
  type               String
  title              String
  s3Key              String       @map("s3_key")
  status             String       @default("active")
  expiryDate         DateTime?    @map("expiry_date") @db.Date
  verificationStatus String?      @map("verification_status")
  createdAt          DateTime     @default(now()) @map("created_at")
  employee           Employee?    @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([employeeId])
  @@map("documents")
}

model Asset {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  employeeId     String?      @map("employee_id")
  name           String
  serial         String?
  assignedAt     DateTime     @default(now()) @map("assigned_at")
  returnedAt     DateTime?    @map("returned_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  employee       Employee?    @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("assets")
}

model Certification {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  employeeId     String       @map("employee_id")
  name           String
  issuedAt       DateTime?    @map("issued_at") @db.Date
  expiryAt       DateTime?    @map("expiry_at") @db.Date
  isMandatory    Boolean      @default(false) @map("is_mandatory")
  createdAt      DateTime     @default(now()) @map("created_at")
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([expiryAt])
  @@map("certifications")
}

model Workflow {
  id             String             @id @default(uuid())
  organizationId String             @map("organization_id")
  name           String
  trigger        String
  condition      String             @default("{}")
  steps          String             @default("[]")
  escalation     String             @default("{}")
  isActive       Boolean            @default(true) @map("is_active")
  createdAt      DateTime           @default(now()) @map("created_at")
  instances      WorkflowInstance[]
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("workflows")
}

model WorkflowInstance {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  workflowId     String       @map("workflow_id")
  entityType     String       @map("entity_type")
  entityId       String       @map("entity_id")
  currentStep    Int          @default(0) @map("current_step")
  status         String       @default("pending")
  deadline       DateTime?
  escalatedAt    DateTime?    @map("escalated_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  approvals      Approval[]
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workflow       Workflow     @relation(fields: [workflowId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organizationId, status])
  @@map("workflow_instances")
}

model Approval {
  id         String           @id @default(uuid())
  instanceId String           @map("instance_id")
  approverId String           @map("approver_id")
  status     String           @default("pending")
  comment    String?
  decidedAt  DateTime?        @map("decided_at")
  createdAt  DateTime         @default(now()) @map("created_at")
  instance   WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("approvals")
}

model Notification {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  userId         String?      @map("user_id")
  channel        String
  template       String?
  payload        String       @default("{}")
  status         String       @default("pending")
  sentAt         DateTime?    @map("sent_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId, status])
  @@map("notifications")
}

model Policy {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  title          String
  category       String       @default("handbook")
  s3Key          String       @map("s3_key")
  version        Int          @default(1)
  approvedAt     DateTime?    @map("approved_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("policies")
}

model KnowledgeArticle {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  category       String
  title          String
  body           String
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("knowledge_articles")
}

model InternalVacancy {
  id               String               @id @default(uuid())
  organizationId   String               @map("organization_id")
  title            String
  departmentId     String?              @map("department_id")
  description      String?
  eligibilityRules String               @default("{}") @map("eligibility_rules")
  status           String               @default("open")
  createdAt        DateTime             @default(now()) @map("created_at")
  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  applications     VacancyApplication[]

  @@map("internal_vacancies")
}

model VacancyApplication {
  id               String          @id @default(uuid())
  vacancyId        String          @map("vacancy_id")
  employeeId       String          @map("employee_id")
  status           String          @default("pending")
  eligibilityCheck String          @default("{}") @map("eligibility_check")
  createdAt        DateTime        @default(now()) @map("created_at")
  vacancy          InternalVacancy @relation(fields: [vacancyId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([vacancyId, employeeId])
  @@map("vacancy_applications")
}

model TalentOpportunity {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  title          String
  type           String
  skillsRequired String       @default("[]") @map("skills_required")
  description    String?
  status         String       @default("open")
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("talent_opportunities")
}

model WorkforceScore {
  id                String       @id @default(uuid())
  organizationId    String       @map("organization_id")
  branchId          String?      @map("branch_id")
  departmentId      String?      @map("department_id")
  date              DateTime     @db.Date
  attendanceHealth  Decimal?     @map("attendance_health") @db.Decimal(5, 2)
  performanceHealth Decimal?     @map("performance_health") @db.Decimal(5, 2)
  learningHealth    Decimal?     @map("learning_health") @db.Decimal(5, 2)
  engagementHealth  Decimal?     @map("engagement_health") @db.Decimal(5, 2)
  complianceHealth  Decimal?     @map("compliance_health") @db.Decimal(5, 2)
  stability         Decimal?     @db.Decimal(5, 2)
  hrHealthOverall   Decimal?     @map("hr_health_overall") @db.Decimal(5, 2)
  createdAt         DateTime     @default(now()) @map("created_at")
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([organizationId, date, branchId, departmentId])
  @@map("workforce_scores")
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  userId         String?      @map("user_id")
  action         String
  entityType     String       @map("entity_type")
  entityId       String?      @map("entity_id")
  oldValue       String?      @map("old_value")
  newValue       String?      @map("new_value")
  ip             String?
  userAgent      String?      @map("user_agent") @db.VarChar(500)
  duration       Int?         @map("duration")
  statusCode     Int?         @map("status_code")
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organizationId, entityType])
  @@index([createdAt])
  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}

model ConsentLog {
  id         String   @id @default(uuid())
  employeeId String   @map("employee_id")
  type       String
  granted    Boolean
  version    String?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("consent_logs")
}

model PayrollMerged {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  employeeId     String       @map("employee_id")
  month          Int
  year           Int
  basicSalary    Decimal      @map("basic_salary") @db.Decimal(12, 2)
  allowances     Decimal      @default(0) @db.Decimal(12, 2)
  deductions     Decimal      @default(0) @db.Decimal(12, 2)
  tax            Decimal      @default(0) @db.Decimal(12, 2)
  netPay         Decimal      @map("net_pay") @db.Decimal(12, 2)
  status         String       @default("DRAFT")
  paidAt         DateTime?    @map("paid_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([employeeId, month, year])
  @@index([organizationId, status])
  @@map("payrolls_merged")
}

model BankDetail {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  employeeId     String       @unique @map("employee_id")
  bankName       String       @map("bank_name")
  accountNumber  String       @map("account_number")
  accountName    String       @map("account_name")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("bank_details")
}

model JobPosting {
  id             String                 @id @default(uuid())
  organizationId String                 @map("organization_id")
  title          String
  department     String
  location       String
  type           String
  description    String
  requirements   String?
  salaryRange    String?                @map("salary_range")
  status         String                 @default("OPEN")
  postedAt       DateTime               @default(now()) @map("posted_at")
  closesAt       DateTime?              @map("closes_at")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")
  applications   JobApplicationMerged[]
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organizationId, status])
  @@map("job_postings")
}

model JobApplicationMerged {
  id          String     @id @default(uuid())
  jobId       String     @map("job_id")
  firstName   String     @map("first_name")
  lastName    String     @map("last_name")
  email       String
  phone       String?
  resumeUrl   String?    @map("resume_url")
  coverLetter String?    @map("cover_letter")
  status      String     @default("NEW")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  job         JobPosting @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("job_applications_merged")
}

model Course {
  id             String               @id @default(uuid())
  organizationId String               @map("organization_id")
  title          String
  description    String?
  category       String
  duration       Int
  status         String               @default("ACTIVE")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  enrollments    LearningEnrollment[]

  @@index([organizationId, category])
  @@map("courses")
}

model LearningEnrollment {
  id          String    @id @default(uuid())
  employeeId  String    @map("employee_id")
  courseId    String    @map("course_id")
  progress    Int       @default(0)
  status      String    @default("ENROLLED")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, courseId])
  @@map("learning_enrollments")
}

model EngagementSurvey {
  id             String               @id @default(uuid())
  organizationId String               @map("organization_id")
  title          String
  description    String?
  questions      String
  status         String               @default("DRAFT")
  startDate      DateTime?            @map("start_date")
  endDate        DateTime?            @map("end_date")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  responses      EngagementResponse[]
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("engagement_surveys")
}

model EngagementResponse {
  id         String           @id @default(uuid())
  surveyId   String           @map("survey_id")
  employeeId String           @map("employee_id")
  answers    String
  score      Int?
  feedback   String?
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  survey     EngagementSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@unique([surveyId, employeeId])
  @@map("engagement_responses")
}

model CompliancePolicy {
  id             String            @id @default(uuid())
  organizationId String            @map("organization_id")
  title          String
  category       String
  content        String
  version        String            @default("1.0")
  status         String            @default("ACTIVE")
  effectiveDate  DateTime          @map("effective_date")
  reviewDate     DateTime?         @map("review_date")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  audits         ComplianceAudit[]
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organizationId, category])
  @@map("compliance_policies")
}

model ComplianceAudit {
  id          String           @id @default(uuid())
  policyId    String           @map("policy_id")
  auditor     String
  findings    String?
  status      String           @default("PENDING")
  completedAt DateTime?        @map("completed_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  policy      CompliancePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@map("compliance_audits")
}

model AttendanceRecords {
  id               String       @id @default(uuid())
  organizationId   String       @map("organization_id")
  employeeId       String       @map("employee_id")
  clockIn          DateTime     @map("clock_in")
  clockOut         DateTime?    @map("clock_out")
  clockInPhoto     String?      @map("clock_in_photo")
  clockOutPhoto    String?      @map("clock_out_photo")
  clockInLocation  String?      @map("clock_in_location")
  clockOutLocation String?      @map("clock_out_location")
  clockInUrl       String?      @map("clock_in_url")
  clockOutUrl      String?      @map("clock_out_url")
  ipAddress        String?      @map("ip_address")
  userAgent        String?      @map("user_agent")
  status           String       @default("CLOCKED_IN")
  notes            String?
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  employee         Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([employeeId])
  @@index([clockIn])
  @@index([status])
  @@map("attendance_records")
}

model CompanyGroup {
  id            String                     @id @default(uuid())
  name          String
  code          String                     @unique
  description   String?
  logoUrl       String?                    @map("logo_url")
  ownerId       String?                    @map("owner_id")
  isActive      Boolean                    @default(true) @map("is_active")
  createdAt     DateTime                   @default(now()) @map("created_at")
  updatedAt     DateTime                   @updatedAt @map("updated_at")
  subscriptions OrganizationSubscription[]
  organizations Organization[]

  @@map("company_groups")
}

model Permission {
  id            String           @id @default(uuid())
  key           String           @unique
  name          String
  description   String?
  module        String
  isSystem      Boolean          @default(false) @map("is_system")
  createdAt     DateTime         @default(now()) @map("created_at")
  organizations Organization[]   @relation("OrgPermissions")
  roles         RoleDefinition[] @relation("RolePermissions")

  @@index([module])
  @@map("permissions")
}

model RoleDefinition {
  id              String        @id @default(uuid())
  organizationId  String?       @map("organization_id")
  name            String
  slug            String
  description     String?
  isSystem        Boolean       @default(false) @map("is_system")
  isActive        Boolean       @default(true) @map("is_active")
  permissions     String        @default("[]")
  createdBy       String?       @map("created_by")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users           User[]
  permissionLinks Permission[]  @relation("RolePermissions")

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("role_definitions")
}

model SubscriptionPlan {
  id            String                     @id @default(uuid())
  name          String
  slug          String                     @unique
  description   String?
  price         Decimal                    @db.Decimal(12, 2)
  currency      String                     @default("NGN")
  billingCycle  String                     @default("monthly")
  maxEmployees  Int                        @default(50) @map("max_employees")
  maxBranches   Int                        @default(3) @map("max_branches")
  isActive      Boolean                    @default(true) @map("is_active")
  isCustom      Boolean                    @default(false) @map("is_custom")
  createdAt     DateTime                   @default(now()) @map("created_at")
  updatedAt     DateTime                   @updatedAt @map("updated_at")
  subscriptions OrganizationSubscription[]
  modules       PlanModule[]

  @@map("subscription_plans")
}

model PlanModule {
  id        String           @id @default(uuid())
  planId    String           @map("plan_id")
  moduleKey String           @map("module_key")
  enabled   Boolean          @default(true)
  config    String?
  plan      SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, moduleKey])
  @@index([planId])
  @@map("plan_modules")
}

model OrganizationSubscription {
  id             String           @id @default(uuid())
  organizationId String           @map("organization_id")
  companyGroupId String?          @map("company_group_id")
  planId         String           @map("plan_id")
  status         String           @default("active")
  startDate      DateTime         @default(now()) @map("start_date")
  endDate        DateTime?        @map("end_date")
  billingCycle   String           @default("monthly") @map("billing_cycle")
  autoRenew      Boolean          @default(true) @map("auto_renew")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  companyGroup   CompanyGroup?    @relation(fields: [companyGroupId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  plan           SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([organizationId, planId])
  @@index([organizationId])
  @@index([companyGroupId])
  @@map("organization_subscriptions")
}

model OnboardingProgress {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  employeeId     String   @unique @map("employee_id")
  steps          String
  progress       Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([organizationId])
  @@map("onboarding_progress")
}
