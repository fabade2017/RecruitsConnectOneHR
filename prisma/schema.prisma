// Models
model Organization {
  id               String            @id @default(uuid())
  name             String
  acronym          String            @unique
  industryTemplate String  @default("generic") @map("industry_template")
  country          String            @default("NG") @db.VarChar(2)
  timezone         String            @default("Africa/Lagos")
  config           String              @db.Text @default("{}")
  logoUrl          String?           @db.Text @map("logo_url")
  watermarkEnabled Boolean           @default(false) @map("watermark_enabled")
  watermarkText    String?           @db.VarChar(200) @map("watermark_text")
  watermarkOpacity Float             @default(0.08) @map("watermark_opacity")
  watermarkPosition String           @default("center") @map("watermark_position")
  primaryColor     String?           @db.VarChar(20) @map("primary_color")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  branches            Branch[]
  departments         Department[]
  employees           Employee[]
  users               User[]
  attendancePolicy    AttendancePolicy?
  devices             Device[]
  shifts              Shift[]
  workSessions        WorkSession[]
  attendanceEvents    AttendanceEvent[]
  attendanceExceptions AttendanceException[]
  leaveTypes          LeaveType[]
  leaveRequests       LeaveRequest[]
  projects            Project[]
  tasks               Task[]
  performanceReviews  PerformanceReview[]
  documents           Document[]
  assets              Asset[]
  certifications      Certification[]
  workflows           Workflow[]
  workflowInstances   WorkflowInstance[]
  notifications       Notification[]
  policies            Policy[]
  knowledgeArticles   KnowledgeArticle[]
  vacancies           InternalVacancy[]
  talentOpportunities TalentOpportunity[]
  workforceScores     WorkforceScore[]
  auditLogs           AuditLog[]
  payrollsMerged      PayrollMerged[]
  bankDetails         BankDetail[]
  jobPostings         JobPosting[]
  courses             Course[]
  engagementSurveys   EngagementSurvey[]
  compliancePolicies  CompliancePolicy[]
  attendanceRecords   AttendanceRecords[]
  companyGroupId      String?           @map("company_group_id")
  companyGroup        CompanyGroup?     @relation(fields: [companyGroupId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customRoles         RoleDefinition[]
  subscriptions       OrganizationSubscription[]
  permissions         Permission[]      @relation("OrgPermissions")

  @@map("organizations")
}

model Branch {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name           String
  address        String?
  location       String? // geography(Point,4326) - requires PostGIS, using String JSON for MVP
  isHeadOffice   Boolean      @default(false) @map("is_head_office")
  createdAt      DateTime     @default(now()) @map("created_at")

  departments Department[]
  employees   Employee[]

  @@index([organizationId])
  @@map("branches")
}

model Department {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branchId       String?      @map("branch_id")
  branch         Branch?      @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parentId       String?      @map("parent_id")
  parent         Department?  @relation("DeptHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children       Department[] @relation("DeptHierarchy")
  name           String
  costCenter     String?      @map("cost_center")
  createdAt      DateTime     @default(now()) @map("created_at")

  employees Employee[]

  @@index([organizationId])
  @@map("departments")
}

model User {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  email          String
  phone          String?
  passwordHash   String       @map("password_hash")
  role           String       @default("employee") // supports custom roles (was enum String)
  customRoleId   String?      @map("custom_role_id")
  customRole     RoleDefinition? @relation(fields: [customRoleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  mfaEnabled     Boolean      @default(false) @map("mfa_enabled")
  lastLoginAt    DateTime?    @map("last_login_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  employee Employee?

  @@unique([organizationId, email])
  @@map("users")
}

model Employee {
  id               String            @id @default(uuid())
  organizationId   String            @map("organization_id")
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employeeCode     String            @map("employee_code") // RC-000245
  qrCode           String?           @db.Text @map("qr_code")
  userId           String?           @unique @map("user_id")
  user             User?             @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  photoUrl         String?           @db.Text @map("photo_url")
  faceProfileRef   String?           @db.Text @map("face_profile_ref")
  departmentId     String?           @map("department_id")
  department       Department?       @relation(fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branchId         String?           @map("branch_id")
  branch           Branch?           @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  jobTitle         String?           @map("job_title")
  grade            String?
  managerId        String?           @map("manager_id")
  manager          Employee?         @relation("Manager", fields: [managerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subordinates     Employee[]        @relation("Manager")
  employmentType   String    @default("permanent") @map("employment_type")
  workArrangement  String   @default("office") @map("work_arrangement")
  status           String    @default("active")
  hireDate         DateTime?         @map("hire_date") @db.Date
  probationEndDate DateTime?         @map("probation_end_date") @db.Date
  skills           String              @db.Text @default("[]")
  metadata         String              @db.Text @default("{}")
  consentFace      Boolean           @default(false) @map("consent_face")
  consentGps       Boolean           @default(false) @map("consent_gps")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  deletedAt        DateTime?         @map("deleted_at")

  workSessions         WorkSession[]
  attendanceEvents     AttendanceEvent[]
  activityRollups      ActivityRollup[]
  leaveRequests        LeaveRequest[]        @relation("Requester")
  leaveApprovals       LeaveRequest[]        @relation("Approver")
  tasksAssigned        Task[]                @relation("Assignee")
  performanceReviews   PerformanceReview[]
  documents            Document[]
  assets               Asset[]
  certifications       Certification[]
  devices              Device[]
  exceptionAssignee    AttendanceException[] @relation("ExceptionAssignee")
  exceptionEmployee    AttendanceException[] @relation("ExceptionEmployee")
  payrollsMerged       PayrollMerged[]
  bankDetail           BankDetail?
  learningEnrollments  LearningEnrollment[]
  engagementResponses  EngagementResponse[]
  attendanceRecords    AttendanceRecords[]

  @@unique([organizationId, employeeCode])
  @@index([organizationId, status])
  @@index([managerId])
  @@map("employees")
}

model AttendancePolicy {
  id                      String   @id @default(uuid())
  organizationId          String   @unique @map("organization_id")
  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  verificationMethods     String     @db.Text @default("[\"standard\"]") @map("verification_methods")
  requireFaceSnapshot     Boolean  @default(false) @map("require_face_snapshot")
  snapshotCaptureEvents   String     @db.Text @default("[\"clock_in\"]") @map("snapshot_capture_events")
  snapshotRetentionDays   Int      @default(90) @map("snapshot_retention_days")
  snapshotAccessRoles     String     @db.Text @default("[\"org_admin\",\"hr_admin\"]") @map("snapshot_access_roles")
  requireGps              Boolean  @default(false) @map("require_gps")
  gracePeriodMinutes      Int      @default(10) @map("grace_period_minutes")
  overtimeRequiresApproval Boolean @default(true) @map("overtime_requires_approval")
  deviceRegistrationRequired Boolean @default(false) @map("device_registration_required")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@map("attendance_policies")
}

model Device {
  id                String       @id @default(uuid())
  organizationId    String       @map("organization_id")
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employeeId        String?      @map("employee_id")
  employee          Employee?    @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  deviceFingerprint String       @map("device_fingerprint")
  deviceType        String   @map("device_type")
  deviceName        String?      @map("device_name")
  isAuthorized      Boolean      @default(true) @map("is_authorized")
  lastSeenAt        DateTime?    @map("last_seen_at")
  createdAt         DateTime     @default(now()) @map("created_at")

  attendanceEvents AttendanceEvent[]

  @@index([organizationId, deviceFingerprint])
  @@map("devices")
}

model Shift {
  id                    String    @id @default(uuid())
  organizationId        String    @map("organization_id")
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name                  String
  type                  String @default("fixed")
  startTime             String?   @map("start_time") // "08:00"
  endTime               String?   @map("end_time")
  timezone              String    @default("Africa/Lagos")
  breakDurationMinutes  Int       @default(60) @map("break_duration_minutes")
  flexibleWindowStart   String?   @map("flexible_window_start")
  flexibleWindowEnd     String?   @map("flexible_window_end")
  isOvernight           Boolean   @default(false) @map("is_overnight")
  createdAt             DateTime  @default(now()) @map("created_at")

  rosterAssignments RosterAssignment[]
  workSessions      WorkSession[]

  @@index([organizationId])
  @@map("shifts")
}

model RosterAssignment {
  id             String   @id @default(uuid())
  employeeId     String   @map("employee_id")
  shiftId        String   @map("shift_id")
  shift          Shift    @relation(fields: [shiftId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  date           DateTime @db.Date
  scheduledMinutes Int    @default(480) @map("scheduled_minutes")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([employeeId, date])
  @@map("roster_assignments")
}

model WorkSession {
  id                   String            @id @default(uuid())
  organizationId       String            @map("organization_id")
  organization         Organization      @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employeeId           String            @map("employee_id")
  employee             Employee          @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  shiftId              String?           @map("shift_id")
  shift                Shift?            @relation(fields: [shiftId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  date                 DateTime          @db.Date
  clockInAt            DateTime?         @map("clock_in_at")
  clockOutAt           DateTime?         @map("clock_out_at")
  breaks               String              @db.Text @default("[]")
  grossDurationMinutes Int?              @map("gross_duration_minutes")
  breakDurationMinutes Int?              @map("break_duration_minutes")
  netWorkingMinutes    Int?              @map("net_working_minutes")
  scheduledMinutes     Int?              @map("scheduled_minutes")
  overtimeMinutes      Int?              @map("overtime_minutes")
  lateMinutes          Int?              @map("late_minutes")
  earlyDepartureMinutes Int?             @map("early_departure_minutes")
  status               String @default("working")
  verificationScore    Int?              @map("verification_score")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  attendanceEvents AttendanceEvent[]
  exceptions       AttendanceException[]

  @@unique([organizationId, employeeId, date])
  @@index([organizationId, date])
  @@map("work_sessions")
}

model AttendanceEvent {
  id                 String               @id @default(uuid())
  organizationId     String               @map("organization_id")
  organization       Organization         @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employeeId         String               @map("employee_id")
  employee           Employee             @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workSessionId      String?              @map("work_session_id")
  workSession        WorkSession?         @relation(fields: [workSessionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  eventType          String  @map("event_type")
  timestamp          DateTime             @default(now())
  verificationMethod String   @default("standard") @map("verification_method")
  deviceId           String?              @map("device_id")
  device             Device?              @relation(fields: [deviceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  location           String? // geography(Point,4326) - String for MVP
  faceSnapshotRef    String?              @db.Text @map("face_snapshot_ref")
  faceConfidence     Decimal?             @map("face_confidence") @db.Decimal(5,2)
  verificationStatus String   @default("pending") @map("verification_status")
  ipAddress          String?              @map("ip_address")
  metadata           String                 @db.Text @default("{}")
  createdAt          DateTime             @default(now()) @map("created_at")

  exceptions AttendanceException[]

  @@index([organizationId, employeeId, timestamp])
  @@index([timestamp])
  @@map("attendance_events")
}

model AttendanceException {
  id                String                   @id @default(uuid())
  organizationId    String                   @map("organization_id")
  organization      Organization             @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  attendanceEventId String?                  @map("attendance_event_id")
  attendanceEvent   AttendanceEvent?         @relation(fields: [attendanceEventId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workSessionId     String?                  @map("work_session_id")
  workSession       WorkSession?             @relation(fields: [workSessionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employeeId        String                   @map("employee_id")
  employee          Employee                 @relation("ExceptionEmployee", fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  type              String
  severity          String        @default("medium")
  status            String          @default("pending")
  assignedTo        String?                  @map("assigned_to")
  assignee          Employee?                @relation("ExceptionAssignee", fields: [assignedTo], references: [id], onDelete: NoAction, onUpdate: NoAction)
  details           String                     @db.Text @default("{}")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")

  @@index([organizationId, status])
  @@map("attendance_exceptions")
}

model ActivityRollup {
  id                    String   @id @default(uuid())
  employeeId            String   @map("employee_id")
  employee              Employee @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  date                  DateTime @db.Date
  loginSessions         Int      @default(0) @map("login_sessions")
  activeSystemMinutes   Int      @default(0) @map("active_system_minutes")
  workflowActions       Int      @default(0) @map("workflow_actions")
  tasksCompleted        Int      @default(0) @map("tasks_completed")
  documentsProcessed    Int      @default(0) @map("documents_processed")
  approvals             Int      @default(0)
  trainingActivities    Int      @default(0) @map("training_activities")
  hrRequests            Int      @default(0) @map("hr_requests")
  computedAt            DateTime @default(now()) @map("computed_at")

  @@unique([employeeId, date])
  @@map("activity_rollups")
}

model LeaveType {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name           String
  accrualRule    String         @db.Text @default("{}") @map("accrual_rule")
  maxDays        Int?         @map("max_days")
  requiresApproval Boolean    @default(true) @map("requires_approval")
  createdAt      DateTime     @default(now()) @map("created_at")

  leaveRequests LeaveRequest[]

  @@index([organizationId])
  @@map("leave_types")
}

model LeaveRequest {
  id                String       @id @default(uuid())
  organizationId    String       @map("organization_id")
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employeeId        String       @map("employee_id")
  employee          Employee     @relation("Requester", fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  leaveTypeId       String       @map("leave_type_id")
  leaveType         LeaveType    @relation(fields: [leaveTypeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  startDate         DateTime     @map("start_date") @db.Date
  endDate           DateTime     @map("end_date") @db.Date
  days              Decimal      @db.Decimal(5,1)
  reason            String?
  status            String  @default("pending")
  approverId        String?      @map("approver_id")
  approver          Employee?    @relation("Approver", fields: [approverId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workflowInstanceId String?     @map("workflow_instance_id")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  @@index([organizationId, status])
  @@map("leave_requests")
}

model Project {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name           String
  description    String?
  ownerId        String?      @map("owner_id")
  status         String       @default("active")
  startDate      DateTime?    @map("start_date") @db.Date
  endDate        DateTime?    @map("end_date") @db.Date
  metadata       String         @db.Text @default("{}")
  createdAt      DateTime     @default(now()) @map("created_at")

  tasks Task[]

  @@index([organizationId])
  @@map("projects")
}

model Task {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  projectId      String?      @map("project_id")
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assigneeId     String?      @map("assignee_id")
  assignee       Employee?    @relation("Assignee", fields: [assigneeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  title          String
  description    String?
  status         String   @default("todo")
  priority       String       @default("medium")
  dueDate        DateTime?    @map("due_date") @db.Date
  completedAt    DateTime?    @map("completed_at")
  estimatedHours Decimal?     @map("estimated_hours") @db.Decimal(5,2)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@index([assigneeId, status])
  @@map("tasks")
}

model PerformanceReview {
  id               String   @id @default(uuid())
  organizationId   String   @map("organization_id")
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employeeId       String   @map("employee_id")
  employee         Employee @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cycle            String   @default("quarterly")
  kpi              String     @db.Text @default("[]")
  managerAssessment String? @map("manager_assessment")
  overallIndicator String?  @map("overall_indicator")
  reviewDate       DateTime? @map("review_date") @db.Date
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([employeeId])
  @@map("performance_reviews")
}

model Document {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employeeId     String?      @map("employee_id")
  employee       Employee?    @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  type           String
  title          String
  s3Key          String       @map("s3_key")
  status         String       @default("active")
  expiryDate     DateTime?    @map("expiry_date") @db.Date
  verificationStatus String?  @map("verification_status")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([employeeId])
  @@map("documents")
}

model Asset {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employeeId     String?      @map("employee_id")
  employee       Employee?    @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name           String
  serial         String?
  assignedAt     DateTime     @default(now()) @map("assigned_at")
  returnedAt     DateTime?    @map("returned_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@map("assets")
}

model Certification {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employeeId     String       @map("employee_id")
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name           String
  issuedAt       DateTime?    @map("issued_at") @db.Date
  expiryAt       DateTime?    @map("expiry_at") @db.Date
  isMandatory    Boolean      @default(false) @map("is_mandatory")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([expiryAt])
  @@map("certifications")
}

model Workflow {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
