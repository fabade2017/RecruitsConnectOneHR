# OneHR Environment
NODE_ENV=development
DATABASE_URL="sqlserver://localhost:1433;database=onehr_v2;user=sa;password=SQLserver@ta2;encrypt=true;trustServerCertificate=true"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="change-me-32-chars-min"
JWT_REFRESH_SECRET="change-me-refresh-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="onehr-docs"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_REGION="us-east-1"

# AI Providers — pluggable, auto fallback mock → groq → ollama → opencode → openai
# Choose one: mock | ollama | groq | opencode | openai (auto if not set, prefers GROQ_API_KEY then OLLAMA_URL)
AI_PROVIDER=mock
# Ollama local LLM
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
# Groq cloud (fast)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile
# OpenCode / Muse Spark local (opencode server)
OPENCODE_API_URL=http://localhost:4096
OPENCODE_MODEL=muse-spark-1.2
# OpenAI fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Legacy keys
ANTHROPIC_API_KEY=

NEXT_PUBLIC_API_URL="http://localhost:3001/v1"
PORT_API=3001
PORT_WEB=3000
ORGANIZATION_DEFAULT_TIMEZONE="Africa/Lagos"
FACE_PROVIDER="stub"
WHATSAPP_PROVIDER="termii"
