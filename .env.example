# OneHR Environment
# Database: PostgreSQL (Prisma provider = postgresql). Local Docker or Supabase pooler.
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/onehr?schema=public"
# DIRECT_URL is required by Prisma when using pgbouncer (Supabase) — use the direct connection string
# DIRECT_URL="postgresql://postgres:password@db.xxx.supabase.co:5432/postgres"
REDIS_URL="redis://localhost:6379"

# JWT — generate strong values: openssl rand -hex 32
# In production the API refuses to start if these are missing or still placeholders.
JWT_SECRET=""
JWT_REFRESH_SECRET=""
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS — required in production (comma-separated browser origins). Without it, production rejects cross-origin browser calls.
CORS_ORIGIN="http://localhost:3000"
# Swagger /api/docs — default off in production; set true to expose
ENABLE_SWAGGER="false"

# Platform Super Admin — only this organisation's super_admin manages subscriptions/plans/groups
SUPER_ADMIN_ORG_ACRONYM="RC"
NEXT_PUBLIC_SUPER_ADMIN_ORG_ACRONYM="RC"

S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="onehr-docs"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_REGION="us-east-1"

# AI Providers — pluggable, auto fallback mock → groq → ollama → opencode → openai
# Choose one: mock | ollama | groq | opencode | openai (auto if not set, prefers GROQ_API_KEY then OLLAMA_URL)
AI_PROVIDER=mock
# Ollama local LLM
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
# Groq cloud (fast)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile
# OpenCode / Muse Spark local (opencode server)
OPENCODE_API_URL=http://localhost:4096
OPENCODE_MODEL=muse-spark-1.2
# OpenAI fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Legacy keys
ANTHROPIC_API_KEY=

NEXT_PUBLIC_API_URL="http://localhost:3001/v1"
PORT_API=3001
PORT_WEB=3000
ORGANIZATION_DEFAULT_TIMEZONE="Africa/Lagos"
FACE_PROVIDER="stub"
WHATSAPP_PROVIDER="termii"

# Email — production hosts (Render) block outbound SMTP, so use HTTPS.
# resend | sendgrid | relay | smtp (auto-detected from keys if blank)
EMAIL_PROVIDER=""
RESEND_API_KEY=""
SENDGRID_API_KEY=""
# Free option: relay through your own cPanel mail server
# (ships with the site build — apps/web/public/mail-relay.php)
MAIL_RELAY_URL=""
MAIL_RELAY_SECRET=""
# SMTP only works where outbound SMTP is reachable (local/dev)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
FROM_EMAIL="supports@rconehr.com"
FROM_NAME="RecruitConnect OneHR"
