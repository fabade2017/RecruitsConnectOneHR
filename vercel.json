{
  "buildCommand": "npm run build --workspace=apps/web",
  "installCommand": "npm install",
  "framework": "nextjs",
  "outputDirectory": "apps/web/.next",
  "regions": ["iad1"],
  "env": {
    "NEXT_PUBLIC_API_URL": "https://api.yourdomain.com/v1",
    "NEXT_PUBLIC_CHATBOT_API": "https://chatbot.yourdomain.com"
  },
  "rewrites": [
    { "source": "/v1/:path*", "destination": "https://api.yourdomain.com/v1/:path*" }
  ]
}
