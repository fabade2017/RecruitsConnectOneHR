# OneHR — Production Environment (copy to .env.production and fill secrets)
NODE_ENV=production
# --- Database ---
POSTGRES_USER=onehr
POSTGRES_PASSWORD=CHANGE_ME_strong_32_chars
POSTGRES_DB=onehr
DATABASE_URL="postgresql://onehr:CHANGE_ME_strong_32_chars@postgres:5432/onehr"

# --- Redis (optional, for rate-limit + queues in scale) ---
REDIS_URL="redis://redis:6379"
REDIS_PASSWORD=""

# --- Auth ---
# REQUIRED in production: generate with `openssl rand -hex 32` each.
# The API refuses to start if these are missing or still CHANGE_ME placeholders.
JWT_SECRET=""
JWT_REFRESH_SECRET=""
JWT_EXPIRES_IN="15m"
ENABLE_SWAGGER="false" # set true to expose /api/docs in prod

# --- Platform Super Admin — only this organisation's super_admin manages subscriptions/plans/groups ---
SUPER_ADMIN_ORG_ACRONYM="RC"
NEXT_PUBLIC_SUPER_ADMIN_ORG_ACRONYM="RC"

# --- CORS & API ---
CORS_ORIGIN="https://www.rconehr.com,https://rconehr.com"
NEXT_PUBLIC_API_URL="https://api.recruitconnect.ng/v1"
# Public web URL used to build staff invite links (${WEB_APP_URL}/onboard/?token=...)
WEB_APP_URL="https://www.rconehr.com"
PORT_API=3001
PORT_WEB=3000

# --- Rate Limit ---
RATE_LIMIT_MAX=100

# --- Email ---
# Hosted platforms (Render, etc.) BLOCK outbound SMTP (ports 25/465/587), which
# causes "Connection timeout". Use HTTPS in production — pick ONE:
#
# Free, keeps your own mail server (no third party, no DNS):
#   Option A (free, own mail server): the relay script ships with the site at
#     apps/web/cpanel/mail-relay.php → https://www.rconehr.com/mail-relay.php
#     Create .relay-secret next to it (same value as MAIL_RELAY_SECRET), then:
#     EMAIL_PROVIDER=relay
#     MAIL_RELAY_URL="https://www.rconehr.com/mail-relay.php"
#     MAIL_RELAY_SECRET="<long random string, same as in the PHP file>"
#
#   Or Resend -> https://resend.com  (verify your domain, add DNS SPF/DKIM)
#     EMAIL_PROVIDER=resend
#     RESEND_API_KEY="re_..."
#   Or SendGrid -> https://sendgrid.com  (single-sender verify needs no DNS)
#     EMAIL_PROVIDER=sendgrid
#     SENDGRID_API_KEY="SG...."
# SMTP below only works where outbound SMTP is reachable (local/dev, or a VPS).
EMAIL_PROVIDER=""            # relay | resend | sendgrid | smtp (auto-detects if blank)
MAIL_RELAY_URL=""
MAIL_RELAY_SECRET=""
RESEND_API_KEY=""
SENDGRID_API_KEY=""
SMTP_HOST="mail.rconehr.com"
SMTP_PORT="465"
SMTP_USER="supports@rconehr.com"
SMTP_PASS=""
FROM_EMAIL="supports@rconehr.com"
FROM_NAME="RecruitConnect OneHR"

# --- SMS (Termii) ---
TERMII_API_KEY=""
TERMII_SENDER_ID="OneHR"

# --- S3 (for snapshots/docs) ---
S3_ENDPOINT="https://s3.recruitconnect.ng"
S3_BUCKET="onehr-prod"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="us-east-1"
