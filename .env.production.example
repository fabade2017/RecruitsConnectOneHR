# OneHR — Production Environment (copy to .env.production and fill secrets)
NODE_ENV=production
# --- Database (MySQL 8) ---
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_strong_32_chars
MYSQL_USER=onehr
MYSQL_PASSWORD=CHANGE_ME_strong_32_chars
MYSQL_DATABASE=onehr
DATABASE_URL="mysql://onehr:CHANGE_ME_strong_32_chars@mysql:3306/onehr"
# Prisma requires DIRECT_URL too — used for migrate deploy/introspection. Same value is fine.
DIRECT_URL="mysql://onehr:CHANGE_ME_strong_32_chars@mysql:3306/onehr"

# --- Redis (optional, for rate-limit + queues in scale) ---
REDIS_URL="redis://redis:6379"
REDIS_PASSWORD=""

# --- Auth ---
JWT_SECRET="CHANGE_ME_32_chars_min_jwt_secret_production"
JWT_REFRESH_SECRET="CHANGE_ME_32_chars_min_refresh_secret_production"
JWT_EXPIRES_IN="15m"
ENABLE_SWAGGER="false" # set true to expose /api/docs in prod

# --- CORS & API ---
CORS_ORIGIN="https://onehr.recruitconnect.ng,https://www.recruitconnect.ng"
NEXT_PUBLIC_API_URL="https://api.recruitconnect.ng/v1"
PORT_API=3001
PORT_WEB=3000

# --- Rate Limit ---
RATE_LIMIT_MAX=100

# --- Tenant isolation ---
# Prisma query extension that forces organization_id scoping on every request.
# Leave "on". Set to "off" only to debug — it disables cross-tenant protection.
TENANT_GUARD="on"

# --- Email (OneHRCon merged - nodemailer) ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
FROM_EMAIL="noreply@recruitconnect.ng"
FROM_NAME="RecruitConnect OneHR"

# --- SMS (Termii) ---
TERMII_API_KEY=""
TERMII_SENDER_ID="OneHR"

# --- S3 (for snapshots/docs) ---
S3_ENDPOINT="https://s3.recruitconnect.ng"
S3_BUCKET="onehr-prod"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="us-east-1"
